{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":46,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":65,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":121,"indent":0,"parameters":[16,16,0]},{"code":121,"indent":0,"parameters":[17,17,1]},{"code":230,"indent":0,"parameters":[120]},{"code":117,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[46,"Sc_End_1",0,0,0,0,100,100,0,0]},{"code":222,"indent":0,"parameters":[]},{"code":232,"indent":0,"parameters":[46,0,0,0,0,0,100,100,255,0,120,true]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　小林"]},{"code":401,"indent":0,"parameters":["　「えー例の計画ですが、"]},{"code":401,"indent":0,"parameters":["　　極めて順調で続々と成果を発揮しています」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「そうかそうか……実に素晴らしい……！"]},{"code":401,"indent":0,"parameters":["　　この調子でどんどん人口を増やしてもらおう……」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　小林"]},{"code":401,"indent":0,"parameters":["　「特に例の町の適任者ですが……"]},{"code":401,"indent":0,"parameters":["　　これまでに２００件以上の成果を上げています」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「２００件以上……？"]},{"code":401,"indent":0,"parameters":["　　とんだミラクルおちんぽボーイだな……」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　小林"]},{"code":401,"indent":0,"parameters":["　「ミラクル……？」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「あぁいやなんでもない……"]},{"code":401,"indent":0,"parameters":["　　引き続き計画を進めてくれ」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「我々には愚民どもには理解できない責務があるのだからな」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　小林"]},{"code":401,"indent":0,"parameters":["　「承知しました」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「ところで……君のお腹なんだが……」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　小林"]},{"code":401,"indent":0,"parameters":["　「あぁこれですか？私も計画の一助となるため"]},{"code":401,"indent":0,"parameters":["　　このとおり種付けしてもらいました」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「………………？？？」"]},{"code":250,"indent":0,"parameters":[{"name":"Onoma-Flash13-4(Low-Short)","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":0,"parameters":[47,"Sc_End_2",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[47,0,0,0,0,0,100,100,255,0,120,true]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「あ…………」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「あぁ……そうか……そうだな…………」"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["　局長"]},{"code":401,"indent":0,"parameters":["　「私も計画のために……"]},{"code":401,"indent":0,"parameters":["　　種付けしてもらわないとな……」"]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["　END"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["　ここまでプレイして頂きありがとうございました！"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":[""]},{"code":401,